# Plantilla del .env del servidor: copiar a /opt/bloqueria/.env y llenar.
# Docker Compose también lee este archivo: no usar el signo $ en las claves.

APP_NAME="Bloquería"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://IP_O_DOMINIO
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_CO

# Dominio para HTTPS automático (ej. bloqueria.com). Sin dominio, dejar :80.
SITE_ADDRESS=:80

LOG_CHANNEL=stderr
LOG_LEVEL=error

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=bloqueria
DB_USERNAME=bloqueria
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

BLOQUERIA_REGISTRO_ABIERTO=false
BLOQUERIA_EMPRESA_NOMBRE=
BLOQUERIA_EMPRESA_NIT=
BLOQUERIA_EMAIL_ADMINISTRADOR=
BLOQUERIA_PASSWORD_ADMINISTRADOR=
BLOQUERIA_EMAIL_PROGRAMADOR=
BLOQUERIA_PASSWORD_PROGRAMADOR=
